  "components": {
    "schemas": {
      "AmenityRequestDTO": {
        "required": [
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "category": {
            "type": "string",
            "nullable": true
          },
          "iconUrl": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "BookingRequestDTO": {
        "required": [
          "checkIn",
          "checkOut",
          "homestayId"
        ],
        "type": "object",
        "properties": {
          "homestayId": {
            "type": "string",
            "format": "uuid"
          },
          "checkIn": {
            "type": "string",
            "format": "date"
          },
          "checkOut": {
            "type": "string",
            "format": "date"
          },
          "guestsCount": {
            "maximum": 100,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "specialRequests": {
            "type": "string",
            "nullable": true
          },
          "contactPhone": {
            "type": "string",
            "format": "tel",
            "nullable": true
          },
          "promotionId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CreateHomestayRequestDTO": {
        "type": "object",
        "properties": {
          "ownerId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "pricePerNight": {
            "type": "number",
            "format": "double"
          },
          "maxGuests": {
            "type": "integer",
            "format": "int32"
          },
          "bedrooms": {
            "type": "integer",
            "format": "int32"
          },
